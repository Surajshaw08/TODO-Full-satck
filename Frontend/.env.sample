# Frontend/.env

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# Authentication
VITE_AUTH_ENABLED=true
VITE_TOKEN_STORAGE_KEY=token

# Feature Flags
VITE_ENABLE_PREMIUM_FEATURES=true

# App Information
VITE_APP_NAME=Todo App
VITE_APP_VERSION=1.0.0

# Timeouts
VITE_API_TIMEOUT=10000
